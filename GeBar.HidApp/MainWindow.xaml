<Window x:Class="GeBar.HidApp.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeBar.HidApp"
        Title="{x:Static local:Strings.AppName}" Width="1040" Height="680" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI Variable Text" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GeBarTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:Strings.FoundDevices}" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ExtendedModeCheck" Content="Extended" Margin="0,0,16,0" VerticalAlignment="Center" Checked="ExtendedModeChanged" Unchecked="ExtendedModeChanged"/>
                <Button Content="{x:Static local:Strings.RefreshDevices}" Click="RefreshClick"/>
                <Button Content="?" Width="38" Padding="0" Margin="8,0,0,0" Click="AboutClick" ToolTip="{x:Static local:Strings.AboutTitle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="DevicesList" SelectionMode="Extended" SelectionChanged="DeviceSelectionChanged" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="DeviceHighlight" Background="Transparent" CornerRadius="5" Padding="5,3">
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Identifier}" Foreground="{DynamicResource SecondaryText}" FontFamily="Cascadia Mono" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter TargetName="DeviceHighlight" Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                        <Setter TargetName="DeviceHighlight" Property="Background" Value="{DynamicResource ControlBackground}"/>
                                        <Setter TargetName="DeviceHighlight" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="DeviceHighlight" Property="BorderThickness" Value="2,0,0,0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="DeviceNameText" Text="{x:Static local:Strings.SelectDevice}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DeviceMetaText" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileLabelBox" MinWidth="120" Margin="0,0,8,0" VerticalAlignment="Center" TextChanged="ProfileLabelChanged" LostFocus="ProfileLabelLostFocus" ToolTip="{x:Static local:Strings.ProfileLabelHint}"/>
                            <Button x:Name="MergeButton" Grid.Column="1" Content="{x:Static local:Strings.MergeProfiles}" Click="MergeProfilesClick" IsEnabled="False" Padding="12,6" Margin="0,0,8,0"/>
                            <Button x:Name="ExportButton" Grid.Column="2" Content="{x:Static local:Strings.Export}" Click="ExportClick" IsEnabled="False" Padding="12,6" Margin="0,0,8,0"/>
                            <Button x:Name="SendToAppButton" Grid.Column="3" Content="{x:Static local:Strings.AddToGeBar}" Click="SendToAppClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" Padding="12,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" ClipToBounds="True">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{x:Static local:Strings.HidInterfaces}" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <ListBox x:Name="InterfacesList" Grid.Row="1" SelectionChanged="InterfaceSelectionChanged" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate><DataTemplate><Grid x:Name="InterfaceRow"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ShortPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ShortPath}"/><TextBlock Grid.Column="1" Text="{Binding ReportSizes}" TextWrapping="NoWrap" Foreground="{DynamicResource SecondaryText}" FontFamily="Cascadia Mono" FontSize="12" Margin="12,0,0,0"/></Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                        <Setter TargetName="InterfaceRow" Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="4,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,4">
                                    <TextBlock Text="{x:Static local:Strings.Packets}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CaptureStatusText" Text="{x:Static local:Strings.NotRunning}" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="SweepButton" Content="{x:Static local:Strings.SweepCommands}" Click="SweepClick" IsEnabled="False" Visibility="Collapsed" Padding="10,4" MinHeight="28" Margin="0,0,6,4"/>
                                    <Button x:Name="CaptureButton" Content="{x:Static local:Strings.StartCapture}" Click="CaptureClick" IsEnabled="False" Padding="10,4" MinHeight="28" Margin="0,0,6,4"/>
                                    <Button Content="{x:Static local:Strings.Clear}" Click="ClearPacketsClick" Padding="10,4" MinHeight="28" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="BatteryRequestButton" Content="{x:Static local:Strings.DetectBattery}" Click="BatteryRequestClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" Padding="10,6" MinHeight="32" Margin="0,0,8,0"/>
                                <Button x:Name="FindChargingButton" Grid.Column="1" Content="{x:Static local:Strings.FindCharging}" Click="FindChargingClick" IsEnabled="False" Padding="10,6" MinHeight="32" Margin="0,0,8,0"/>
                                <Button x:Name="RememberOffButton" Grid.Column="2" Content="{x:Static local:Strings.RememberOff}" Click="RememberOffClick" IsEnabled="False" Padding="10,6" MinHeight="32"/>
                            </Grid>
                            <TextBox x:Name="PacketsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="12"/>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{DynamicResource SecondaryText}" Margin="4,12,0,0" Text="{x:Static local:Strings.PassiveScanHint}"/>
    </Grid>
</Window>
