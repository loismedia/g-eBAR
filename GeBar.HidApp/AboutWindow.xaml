<Window x:Class="GeBar.HidApp.AboutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeBar.HidApp"
        Title="{x:Static local:Strings.AboutTitle}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GeBarTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="{x:Static local:Strings.AppName}" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/>
        <TextBlock x:Name="DeveloperText" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,2,0,0"/>
        <TextBlock Text="{x:Static local:Strings.AboutText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <Button x:Name="CloseButton" Content="{x:Static local:Strings.Close}" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="110" Margin="0,18,0,0" Click="CloseClick"/>
    </StackPanel>
</Window>
