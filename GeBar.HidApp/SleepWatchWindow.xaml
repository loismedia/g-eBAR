<Window x:Class="GeBar.HidApp.SleepWatchWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeBar.HidApp"
        Title="{x:Static local:Strings.SleepWatchTitle}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GeBarTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="{x:Static local:Strings.SleepWatchText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <TextBlock Text="{x:Static local:Strings.SleepSeconds}" VerticalAlignment="Center"/>
            <TextBox x:Name="SecondsBox" Style="{StaticResource NumberBox}" Margin="12,0,0,0" MaxLength="5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{x:Static local:Strings.Cancel}" MinWidth="110" Margin="0,0,8,0" Click="CancelClick"/>
            <Button x:Name="StartButton" Content="{x:Static local:Strings.SleepWatchStart}" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="StartClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
