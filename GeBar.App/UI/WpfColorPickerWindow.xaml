<Window x:Class="GeBar.App.WpfColorPickerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" MinWidth="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="#F5F5F5" FontFamily="Segoe UI Variable Text" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#373737"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#333333"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="#00D2D2"/><Setter Property="SelectionBrush" Value="#00D2D2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SliderRepeat" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SliderThumb" TargetType="Thumb"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Dot" Fill="#FFFFFF" Stroke="#00D2D2" StrokeThickness="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="StrokeThickness" Value="4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Slider"><Setter Property="Height" Value="26"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#00D2D2" Style="{StaticResource SliderRepeat}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#4A4A4A" Style="{StaticResource SliderRepeat}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="1" Height="54" Margin="0,0,0,14" CornerRadius="9" Background="#333333" Padding="5"><Border x:Name="ColorPreview" CornerRadius="6"/></Border>
        <UniformGrid Grid.Row="2" Columns="6" Rows="2" Margin="-5,0">
            <Button Style="{StaticResource Swatch}" Background="#00D2D2" Tag="#00D2D2" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#0078D4" Tag="#0078D4" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#107C10" Tag="#107C10" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#34C759" Tag="#34C759" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#FFB900" Tag="#FFB900" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#FF8C00" Tag="#FF8C00" Click="SwatchClick"/>
            <Button Style="{StaticResource Swatch}" Background="#E81123" Tag="#E81123" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#E74856" Tag="#E74856" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#B146C2" Tag="#B146C2" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#744DA9" Tag="#744DA9" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="SwatchClick"/><Button Style="{StaticResource Swatch}" Background="#7A7A7A" Tag="#7A7A7A" Click="SwatchClick"/>
        </UniformGrid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="R" VerticalAlignment="Center"/><Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbChanged"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="G" VerticalAlignment="Center"/><Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbChanged"/></Grid>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="B" VerticalAlignment="Center"/><Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbChanged"/></Grid>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock x:Name="HexLabel" VerticalAlignment="Center"/><TextBox x:Name="HexBox" Grid.Column="1" MaxLength="9" VerticalContentAlignment="Center" TextChanged="HexChanged"/></Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelButton" Margin="0,0,10,0" Click="CancelClick"/><Button x:Name="OkButton" Background="#00D2D2" Foreground="#101010" Click="OkClick"/></StackPanel>
    </Grid>
</Window>
