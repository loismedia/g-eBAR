<Window x:Class="GeBar.App.ControlCenterWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="548" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeBar.UI;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/></Grid.RowDefinitions>
            <StackPanel x:Name="TabStrip" Orientation="Horizontal">
                <Button x:Name="HomeTab" Style="{StaticResource TabButton}" Click="HomeTabClick"/>
                <Button x:Name="SettingsTab" Style="{StaticResource TabButton}" Click="SettingsTabClick"/>
                <Button x:Name="AppearanceTab" Style="{StaticResource TabButton}" Click="AppearanceTabClick"/>
                <Button x:Name="AboutTab" Style="{StaticResource TabButton}" Click="AboutTabClick" Margin="0"/>
            </StackPanel>
            <Border x:Name="TabIndicator" Grid.Row="1" Height="3" Width="0" CornerRadius="2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorOffset"/></Border.RenderTransform>
            </Border>
        </Grid>

        <Grid Grid.Row="1">

            <Grid x:Name="HomePage" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <TextBlock x:Name="DeviceStatusTitleText" Style="{StaticResource GroupHeader}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="{StaticResource CardGap}">
                        <Border Style="{StaticResource LastRow}" Padding="16,16" MinHeight="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                    <ColumnDefinition Width="Auto" MinWidth="184"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch" Width="Auto" Margin="0,0,0,10"
                                              SelectionChanged="DeviceComboChanged"/>
                                    <TextBlock x:Name="DeviceNameText" TextAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Height="30" CornerRadius="6" BorderBrush="{DynamicResource PrimaryText}" BorderThickness="2" Padding="3">
                                        <Grid x:Name="BatteryTrack" ClipToBounds="True">
                                            <Border x:Name="BatteryFill" Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PercentageText" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="ChargingIconText" Text="⚡" FontFamily="Segoe UI Emoji" FontSize="22" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusText" TextAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="UpdatedText" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="{StaticResource CardGap}">
                        <Border Style="{StaticResource LastRow}" MinHeight="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="RefreshButton" Margin="0,0,5,0" Padding="6,8" Click="RefreshClick"/>
                                <Button x:Name="LogsButton" Grid.Column="1" Margin="5,0" Padding="6,8" Click="LogsClick"/>
                                <Button x:Name="UpdatesButton" Grid.Column="2" Margin="5,0" Padding="6,8" Click="UpdatesClick"/>
                                <Button x:Name="HidButton" Grid.Column="3" Margin="5,0,0,0" Padding="6,8" Click="HidClick"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border x:Name="HistoryCard" Grid.Row="3" Style="{StaticResource Card}">
                        <Border Style="{StaticResource LastRow}" MinHeight="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HistoryTitleText" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="HistoryWarningText" Text="⚠" FontFamily="Segoe UI Emoji" FontSize="12" Margin="6,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HistoryEstimateText" Grid.Column="1" Foreground="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                    <Button x:Name="HistoryRangeButton" Grid.Column="2" FontSize="11" Padding="10,3" MinWidth="78" Click="HistoryRangeClick"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Canvas x:Name="HistoryScale" Width="26" Margin="0,0,6,0"/>
                                    <Canvas x:Name="HistoryTimeline" Grid.Row="1" Grid.Column="1" Height="14" Margin="0,4,0,0"/>
                                    <Grid x:Name="HistoryPlot" Grid.Column="1" MinHeight="96" ClipToBounds="True" SizeChanged="HistoryPlotSizeChanged">
                                        <Path x:Name="HistoryGrid" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                                        <Path x:Name="HistoryFill" Fill="{DynamicResource AccentBrush}" Opacity="0.14"/>
                                        <Path x:Name="HistoryLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Canvas x:Name="HistoryMarkers"/>
                                        <TextBlock x:Name="HistoryEmptyText" Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>

                    <Border x:Name="DiagnosticsCard" Grid.Row="3" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Border Style="{StaticResource LastRow}" MinHeight="0">
                            <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                     Background="Transparent" Foreground="{DynamicResource SecondaryText}"
                                     BorderThickness="0" Padding="0" MinHeight="0" VerticalContentAlignment="Top"
                                     FontFamily="Cascadia Mono" FontSize="11"/>
                        </Border>
                    </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="MonitoringTitleText" Style="{StaticResource GroupHeader}"/>
                    <Border Style="{StaticResource Card}" Margin="{StaticResource CardGap}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <CheckBox x:Name="StartupCheck"/>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IntervalLabel" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="IntervalBox" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="RawRow" Style="{StaticResource Row}">
                                <CheckBox x:Name="RawCheck"/>
                            </Border>
                            <Border x:Name="AllDevicesTooltipRow" Style="{StaticResource Row}">
                                <CheckBox x:Name="AllDevicesTooltipCheck"/>
                            </Border>
                            <Border x:Name="AutoSwitchRow" Style="{StaticResource LastRow}">
                                <CheckBox x:Name="AutoSwitchCheck"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NotificationsTitleText" Style="{StaticResource GroupHeader}"/>
                    <Border Style="{StaticResource Card}" Margin="{StaticResource CardGap}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <CheckBox x:Name="NotifyCheck"/>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox x:Name="NotifyChargingCheck"/>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <CheckBox x:Name="NotifyFullCheck"/>
                            </Border>
                            <Border x:Name="NotifyScopeRow" Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NotifyScopeLabel" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="NotifyScopeCombo" Grid.Column="1" Width="220"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WarningLabel" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="WarningBox" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CriticalLabel" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="CriticalBox" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DeveloperAccessPanel" Visibility="Collapsed">
                    <TextBlock x:Name="GitHubAccessTitleText" Style="{StaticResource GroupHeader}"/>
                    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                        <Border Style="{StaticResource LastRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GitHubTokenLabel" Style="{StaticResource RowLabel}"/>
                                <PasswordBox x:Name="GitHubTokenBox" Grid.Column="1" Width="210"/>
                            </Grid>
                        </Border>
                    </Border>
                    <Button x:Name="SwitchDevButton" HorizontalAlignment="Right" Margin="0,12,0,0" Click="SwitchDevClick"/>
                    </StackPanel>
                    <Button x:Name="SwitchPublicButton" HorizontalAlignment="Right" Margin="0,12,0,0" Click="SwitchPublicClick" Visibility="Collapsed"/>
                    <Button x:Name="RemoveHidButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="180" Margin="0,16,0,0" Click="RemoveHidClick"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AppearancePage" Margin="0,0,10,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TrayAppearanceTitleText" Style="{StaticResource GroupHeader}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconStyleLabel" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="IconStyleCombo" Grid.Column="1"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconScaleLabel" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="IconScaleCombo" Grid.Column="1"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NormalColorLabel" Style="{StaticResource RowLabel}"/>
                                    <Button x:Name="NormalColorButton" Grid.Column="1" Style="{StaticResource ColorButton}" Click="ColorClick"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WarningColorLabel" Style="{StaticResource RowLabel}"/>
                                    <Button x:Name="WarningColorButton" Grid.Column="1" Style="{StaticResource ColorButton}" Click="ColorClick"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource LastRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CriticalColorLabel" Style="{StaticResource RowLabel}"/>
                                    <Button x:Name="CriticalColorButton" Grid.Column="1" Style="{StaticResource ColorButton}" Click="ColorClick"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
            </Grid>

            <Grid x:Name="AboutPage" Margin="0,0,10,0" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="24,32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <Image x:Name="LogoImage" Height="64" Stretch="Uniform" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="AboutProductText" TextAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}"/>
                        <StackPanel x:Name="ModulesPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="ModulesTitleText" TextAlignment="Center" FontWeight="SemiBold"/>
                            <ItemsControl x:Name="ModulesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock x:Name="AboutDescriptionText" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="DeveloperText" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button x:Name="ChangelogButton" Content="📋" FontSize="16" Padding="0" Width="38" Height="34" Margin="0,0,8,0" Click="ChangelogClick"/>
                            <Button x:Name="ReportBugButton" Content="🐞" FontSize="16" Padding="0" Width="38" Height="34" Click="ReportBugClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Button x:Name="SaveButton" Grid.Row="2" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="130" Margin="0,16,10,0" Click="SaveClick" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform><ScaleTransform x:Name="SaveButtonScale"/></Button.RenderTransform>
        </Button>
    </Grid>
</Window>
