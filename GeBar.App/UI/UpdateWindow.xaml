<Window x:Class="GeBar.App.UpdateWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="500" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI Variable Text" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeBar.UI;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="ProgressRoot" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Decorator x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4">
                                <Border.RenderTransform><TranslateTransform x:Name="IndicatorOffset"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Width" Value="120"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndeterminateLoop">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndicatorOffset" Storyboard.TargetProperty="X"
                                                             From="-120" To="480" Duration="0:0:1.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndeterminateLoop"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="AvailableText" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="CurrentText" Grid.Row="1" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryText}"/>
        <Border x:Name="NightlyWarning" Grid.Row="2" Margin="0,2,0,18" Padding="12,9" CornerRadius="7" Background="#26FFB300" Visibility="Collapsed">
            <TextBlock x:Name="NightlyWarningText" Foreground="#FFFFC247" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
            <FlowDocumentScrollViewer x:Name="ChangelogViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" IsToolBarVisible="False"/>
        </Border>
        <CheckBox x:Name="HidCheckBox" Grid.Row="4" Margin="0,14,0,0" IsChecked="False" Checked="HidSelectionChanged" Unchecked="HidSelectionChanged"/>
        <StackPanel x:Name="DownloadProgressPanel" Grid.Row="5" Margin="0,14,0,0" Visibility="Collapsed" Opacity="0">
            <Grid Margin="0,0,0,6"><TextBlock x:Name="DownloadStatusText"/><TextBlock x:Name="DownloadProductText" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryText}"/></Grid>
            <ProgressBar x:Name="DownloadProgressBar" Height="7" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="HistoryButton" MinWidth="130" Margin="0,0,10,0" Padding="16,9" Click="HistoryClick"/>
            <Button x:Name="DownloadButton" MinWidth="130" Padding="16,9" Style="{StaticResource PrimaryButton}" Click="DownloadClick"/>
        </StackPanel>
    </Grid>
</Window>
